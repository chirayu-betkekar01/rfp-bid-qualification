# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_EXTRACT_MODEL=
OPENROUTER_DRAFT_MODEL=
# Optional: model for the Yes / No / Maybe suggestions (defaults to OPENROUTER_DRAFT_MODEL)
OPENROUTER_SUGGEST_MODEL=
# Local Supabase (npx supabase start). Use the hosted project's URL once it exists.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase (npx supabase start). Database tests run only against this.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Slack incoming webhook for the demo channel (messages are logged as "not sent" without it)
SLACK_WEBHOOK_URL=
# Base of the links in Slack messages (default http://localhost:3100)
APP_BASE_URL=

# Signs the review app's sign-in cookie. Without it, a random one is made per server start
# (everyone is signed out on restart). Generate one with: openssl rand -base64 32
SESSION_SECRET=
