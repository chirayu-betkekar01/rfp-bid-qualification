# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_EXTRACT_MODEL=
OPENROUTER_DRAFT_MODEL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfp

